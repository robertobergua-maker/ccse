rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "roberto.bergua@gmail.com";
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true;
    }

    function ownsStoredRecord() {
      return signedIn()
        && resource != null
        && resource.data.user_id == request.auth.uid;
    }

    function ownsNewRecord() {
      return signedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.user_id == resource.data.user_id;
    }

    function canWriteOwnRecord() {
      return ownsNewRecord() && (!isBlocked() || isAdmin());
    }

    function canUpdateOwnRecord() {
      return ownsStoredRecord() && ownsNewRecord() && keepsOwner() && (!isBlocked() || isAdmin());
    }

    function canClaimInviteCode(codeId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.used_by_uid == request.auth.uid
        && request.resource.data.used_by_email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.invite_code == codeId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["used", "used_by_uid", "used_by_email", "used_at"]);
    }

    function canReadInviteCode() {
      return resource.data.used == false
        || (
          signedIn()
          && resource.data.used == true
          && resource.data.used_by_uid == request.auth.uid
          && resource.data.used_by_email == request.auth.token.email
        );
    }

    function hasClaimedInviteCodeForNewUser(userId) {
      return request.resource.data.invite_code is string
        && getAfter(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.used == true
        && getAfter(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.used_by_uid == userId
        && getAfter(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.used_by_email == request.auth.token.email;
    }

    match /users/{userId} {
      // Cada perfil solamente es visible y editable por su propio usuario.
      allow read: if isCurrentUser(userId) || isAdmin();
      allow create: if isAdmin()
        || (
          isCurrentUser(userId)
          && request.resource.data.id == userId
          && request.resource.data.email == request.auth.token.email
          && hasClaimedInviteCodeForNewUser(userId)
          && request.resource.data.keys().hasOnly(["id", "name", "email", "invite_code", "created_at", "last_login"])
          && !request.resource.data.keys().hasAny(["blocked", "blocked_at", "blocked_by", "blocked_reason"])
        );
      allow update: if isAdmin()
        || (
          isCurrentUser(userId)
          && resource.data.id == userId
          && request.resource.data.id == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["blocked", "blocked_at", "blocked_by", "blocked_reason"])
        );
      allow delete: if false;
    }

    match /questions/{questionId} {
      // El banco es público para que los invitados puedan practicar sin cuenta.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if ownsStoredRecord() || isAdmin();
      allow delete: if isAdmin() || (ownsStoredRecord() && !isBlocked());
      allow create: if canWriteOwnRecord();
      allow update: if canUpdateOwnRecord();
    }

    match /exam_answers/{answerId} {
      allow read: if ownsStoredRecord() || isAdmin();
      allow delete: if isAdmin() || (ownsStoredRecord() && !isBlocked());
      allow create: if canWriteOwnRecord();
      allow update: if canUpdateOwnRecord();
    }

    match /user_question_stats/{statId} {
      allow read: if ownsStoredRecord() || isAdmin();
      allow delete: if isAdmin() || (ownsStoredRecord() && !isBlocked());
      allow create: if canWriteOwnRecord()
        && statId == request.auth.uid + "_" + request.resource.data.question_id;
      allow update: if canUpdateOwnRecord()
        && request.resource.data.question_id == resource.data.question_id
        && statId == request.auth.uid + "_" + resource.data.question_id;
    }

    match /institutions/{institutionId} {
      // Solo el admin puede leer y gestionar instituciones.
      allow read, write: if isAdmin();
    }

    match /invite_codes/{codeId} {
      // Los visitantes solo pueden comprobar un código concreto, nunca listar la colección.
      // El usuario recién autenticado puede marcar su propio código como usado una sola vez.
      allow get: if isAdmin() || canReadInviteCode();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canClaimInviteCode(codeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
